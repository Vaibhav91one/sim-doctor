/target
**/*.rs.bk

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Saved scan baselines (issue #12). A baseline is a local artifact: it names
# the reader, the card's rule findings and the paths a walk saw, and it belongs
# in a CI workspace rather than in a repository. Written by --baseline, read by
# --diff. The patterns cover the common spellings because the path is whatever
# the operator typed and a baseline that gets committed is a card description
# in the history forever.
*.baseline.json
baseline.json
baseline-*.json
*-baseline.json
.baselines/

# SIM/eUICC artifacts and secrets - NEVER commit
*.key
*.der
*.crt
*.pem
*.pvk
profile.json
profiles.json
secrets.toml
captures/

# Issue drafting scratch (the issues themselves live on GitHub)
.issues/
