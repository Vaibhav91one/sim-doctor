            [CompletionResult]::new('--key-version', '--key-version', [CompletionResultType]::ParameterName, 'Key version number for INITIALIZE UPDATE, two hex digits; 00 (default) lets the card choose its first key set')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Emit one JSON envelope of kind "gp" on stdout')
