            cand --max-segment 'Most data bytes in one STORE DATA block, 1 to 255 (default 120, as lpac; 255 is the short-APDU Lc limit). Some eUICCs reject full 255-byte blocks'
            cand --yes 'Send the request, then re-read the list and confirm. Without it nothing is changed'
            cand --json 'Emit one lpac envelope on stdout, and nothing else'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'sim-doctor;euicc;notifications;dump'= {
